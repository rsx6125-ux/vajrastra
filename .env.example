# Reference only: export these in your shell. This app does not auto-load .env.
PORT=8000
# VAJRASTRA_DATA=/absolute/path/to/private/local/data
# Optional trusted HTTPS AI gateway, documented in docs/INTEGRATIONS.md
# ASSISTANT_GATEWAY_URL=https://your-approved-gateway.example/assist
# ASSISTANT_GATEWAY_TOKEN=replace-locally
# Optional installed Tesseract language packs
OCR_LANGUAGES=eng
